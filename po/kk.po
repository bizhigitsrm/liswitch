#: prefs.js:2033
msgid "Enable Text Correction"
msgstr "Мәтінді түзетуді қосу"

#: prefs.js:2034
msgid "Convert text typed in the wrong layout into the alternate language"
msgstr "Қате тілде терілген мәтінді балама тілге түрлендіру"

#: prefs.js:2045
msgid "Double Left Shift Trigger"
msgstr "Сол жақ Shift қос басу арқылы іске қосу"

#: prefs.js:2046
msgid "Press Left Shift twice quickly to convert the last typed word"
msgstr "Соңғы терілген сөзді түрлендіру үшін сол жақ Shift пернесін жылдам екі рет басыңыз"

#: prefs.js:2057
msgid "Convert Selected Text"
msgstr "Ерекшеленген мәтінді түзету"

#: prefs.js:2058
msgid ""
"When the typing buffer is empty, the manual hotkey copies, converts, and "
"replaces selected text"
msgstr "Теру буфері бос болса, пернелер тіркесімі ерекшеленген мәтінді көшіріп, түрлендіреді және ауыстырады"

#: prefs.js:2079
msgid "Manual Hotkey"
msgstr "Қолмен шақыру пернесі"

#: prefs.js:2080
msgid "Keyboard shortcut to manually trigger text conversion"
msgstr "Мәтінді түрлендіруді қолмен іске қосуға арналған пернелер тіркесімі"

#: prefs.js:2087
msgid "Shortcut to trigger conversion of the most recently typed word"
msgstr "Соңғы терілген сөзді түрлендіру пернесі"

#: prefs.js:2098
msgid "Terminal Applications"
msgstr "Терминал қолданбалары"

#: prefs.js:2099
msgid ""
"Applications where Ctrl+Shift+V and Ctrl+Shift+C are used instead of Ctrl+V "
"and Ctrl+C"
msgstr "Ctrl+V және Ctrl+C орнына Ctrl+Shift+V және Ctrl+Shift+C қолданылатын қолданбалар"

#: prefs.js:2106
msgid "Reset terminal list to defaults"
msgstr "Терминалдар тізімін әдепкі мәндерге қайтару"

#: prefs.js:2116
msgid "Add terminal app ID or WM_CLASS (e.g. org.gnome.Console)"
msgstr "Терминал ID немесе WM_CLASS қосу (мыс. org.gnome.Console)"

#: prefs.js:2122
msgid "Configured Terminals"
msgstr "Бапталған терминалдар"

#: prefs.js:2144
msgid "No terminal applications configured"
msgstr "Терминал қолданбалары бапталмаған"

#: prefs.js:2148
#, javascript-format
msgid "%d terminal(s) configured"
msgstr "%d терминал бапталды"

#: prefs.js:2159
msgid "Remove from terminal list"
msgstr "Терминалдар тізімінен өшіру"

